# Copie ce fichier en `.env` puis renseigne ta vraie clé.
# Le fichier `.env` est ignoré par git (voir .gitignore) et ne sera JAMAIS commité.
# Ne mets jamais de vraie clé dans ce fichier `.env.example`.

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modèle Anthropic utilisé par la couche stratégique (LLMOrchestrator).
# Optionnel : si absent, retombe sur "claude-sonnet-5".
NZOYI_ANTHROPIC_MODEL=claude-sonnet-5

# Fournisseur LLM utilisé par la couche stratégique (LLMOrchestrator).
# Optionnel : valeurs valides "anthropic" | "openai_compatible".
# Si absent ou invalide, retombe sur "anthropic" (jamais d'erreur).
NZOYI_LLM_PROVIDER=anthropic

# Les 5 variables suivantes ne sont lues que si NZOYI_LLM_PROVIDER=openai_compatible.
# Un seul adaptateur générique (OpenAICompatibleBackend) sert toute API Chat
# Completions compatible OpenAI : OpenRouter aujourd'hui, GPT-6 Astra et des
# modèles locaux via Ollama plus tard — juste en changeant ces valeurs, jamais
# le code.

# URL de base de l'API compatible OpenAI.
# Optionnel : si absent, retombe sur "https://openrouter.ai/api/v1".
NZOYI_OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1

# Modèle chez ce fournisseur.
# Optionnel : si absent, retombe sur "deepseek/deepseek-r1".
NZOYI_OPENAI_COMPAT_MODEL=deepseek/deepseek-r1

# Clé API du fournisseur compatible OpenAI (ex. clé OpenRouter).
# Ne mets jamais de vraie clé dans ce fichier `.env.example`.
NZOYI_OPENAI_COMPAT_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Niveau d'effort de raisonnement (ex. pour GPT-6 Astra plus tard).
# Optionnel, laisse vide/absent tant qu'on est sur OpenRouter/DeepSeek-R1 :
# ce fournisseur pilote le raisonnement via `temperature` (fixé à 0.0 dans le
# code pour la reproductibilité), pas via `reasoning_effort`. Un fournisseur
# qui n'accepte que `reasoning_effort` (GPT-6 Astra, pressenti) renseignera
# cette variable à la place — jamais les deux en même temps.
NZOYI_OPENAI_COMPAT_REASONING_EFFORT=

# Plafond de tokens en sortie pour ce backend.
# Optionnel : si absent ou invalide, retombe sur 4096. Les modèles "thinking"
# (ex. DeepSeek-R1 via Ollama en local) peuvent épuiser tout leur budget en
# raisonnement interne avant d'écrire le JSON final — un plafond trop bas
# renvoie alors un contenu vide (repli déterministe déclenché, sans vraie
# décision du modèle). Indépendant du max_tokens=1024 d'AnthropicBackend.
NZOYI_OPENAI_COMPAT_MAX_TOKENS=4096
